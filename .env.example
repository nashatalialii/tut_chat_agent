# Shared
NODE_ENV=development

# Backend services
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6379
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=egypt_traffic_laws
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=bge-m3

# Legal RAG retrieval / grounding
RAG_CANDIDATE_K=12
RAG_FINAL_K=4
RAG_RRF_K=60
RAG_EXCERPT_CHARS=500
RAG_CONTEXT_CHARS_PER_CHUNK=1800
RAG_MIN_RERANK_SCORE=0.20
RAG_MAX_SEMANTIC_DISTANCE=1.20
RAG_DEBUG=false
REQUIRE_VERIFIED_LEGAL_SOURCES=true
LEGAL_VERSION=current

# Legal document extraction / chunking
LEGAL_CHUNK_MAX_CHARS=1800
LEGAL_CHUNK_OVERLAP_CHARS=180
PDF_MIN_TEXT_CHARS_PER_PAGE=40
MAX_CORRUPTED_TEXT_RATIO=0.02

# Cache / memory / performance
ENABLE_SEMANTIC_CACHE=false
MEMORY_CONTEXT_CHARS=700
LLM_NUM_PREDICT=280
LLM_NUM_CTX=3072
LLM_TIMEOUT_MS=60000
RAG_SEARCH_TIMEOUT_MS=30000
REDIS_TIMEOUT_MS=1500
OLLAMA_KEEP_ALIVE=20m
CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_THRESHOLD=0.92
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# Data and secure knowledge-base upload
DATA_DIR=../data
UPLOAD_DIR=../data/uploads
QUARANTINE_DIR=../data/quarantine
MAX_UPLOAD_BYTES=26214400
# Set a long random token before using admin upload/review APIs.
# ADMIN_API_TOKEN=replace-with-at-least-16-random-characters
# Optional token for future authenticated user-only endpoints.
# USER_API_TOKEN=replace-with-at-least-16-random-characters

# Optional voice microservices. Voice fails closed if STT is not configured.
# STT_SERVICE_URL=http://localhost:7001
# TTS_SERVICE_URL=http://localhost:7002
VOICE_MAX_AUDIO_BYTES=10485760

# Optional comma-separated local models for benchmark script.
# LLM_BENCHMARK_MODELS=llama3.1:8b,qwen2.5:7b

# Frontend
NEXT_PUBLIC_TRPC_HTTP_URL=http://localhost:4000/trpc
NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:4000/voice
NEXT_PUBLIC_APP_NAME=مساعد قانون المرور المصري

# Local voice (CPU-only)
WHISPER_MODEL=small
WHISPER_LANGUAGE=ar
WHISPER_CPU_THREADS=4
WHISPER_COMPUTE_TYPE=int8
PIPER_VOICE=ar_JO-kareem-medium
VOICE_MAX_TTS_CHARS=5000
VOICE_STT_TIMEOUT_MS=120000
VOICE_TTS_TIMEOUT_MS=60000
