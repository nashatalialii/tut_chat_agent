{
  "name": "@egypt-traffic/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    "./router": "./src/trpc/router.ts",
    "./voice-protocol": "./src/voice/protocol.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "ingest": "tsx src/scripts/ingest.ts",
    "test": "tsx --test tests/*.test.ts",
    "eval:retrieval": "tsx src/scripts/evaluate.ts",
    "benchmark:models": "tsx src/scripts/benchmark-models.ts",
    "eval:answers": "tsx src/scripts/evaluate-answers.ts"
  },
  "dependencies": {
    "@langchain/community": "^0.3.49",
    "@langchain/core": "^0.3.61",
    "@langchain/ollama": "^0.2.3",
    "@langchain/textsplitters": "^0.1.0",
    "@trpc/server": "^11.4.3",
    "chromadb": "^1.10.5",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "ioredis": "^5.6.1",
    "nanoid": "^5.1.5",
    "pdf-parse": "^1.1.1",
    "superjson": "^2.2.2",
    "ws": "^8.18.2",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.30",
    "@types/pdf-parse": "^1.1.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
