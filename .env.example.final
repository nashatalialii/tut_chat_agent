COMPOSE_PROJECT_NAME=egypt-traffic-rag-bot
NODE_ENV=production
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:3000
REDIS_URL=redis://redis:6379
CHROMA_URL=http://chroma:8000
CHROMA_COLLECTION=egypt_traffic_laws
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=bge-m3

RAG_CANDIDATE_K=12
RAG_FINAL_K=4
RAG_RRF_K=60
RAG_EXCERPT_CHARS=500
RAG_CONTEXT_CHARS_PER_CHUNK=1800
RAG_MIN_RERANK_SCORE=0.20
RAG_MAX_SEMANTIC_DISTANCE=1.20
RAG_DEBUG=false
REQUIRE_VERIFIED_LEGAL_SOURCES=true
LEGAL_VERSION=current
LEGAL_CHUNK_MAX_CHARS=1800
LEGAL_CHUNK_OVERLAP_CHARS=180
PDF_MIN_TEXT_CHARS_PER_PAGE=40
MAX_CORRUPTED_TEXT_RATIO=0.02
ENABLE_SEMANTIC_CACHE=false
MEMORY_CONTEXT_CHARS=700
LLM_NUM_PREDICT=280
LLM_NUM_CTX=3072
LLM_TIMEOUT_MS=90000
RAG_SEARCH_TIMEOUT_MS=30000
REDIS_TIMEOUT_MS=1500
OLLAMA_KEEP_ALIVE=20m
CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_THRESHOLD=0.92
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
DATA_DIR=/app/data
UPLOAD_DIR=/app/data/uploads
QUARANTINE_DIR=/app/data/quarantine
MAX_UPLOAD_BYTES=26214400

WHISPER_MODEL=small
WHISPER_LANGUAGE=ar
WHISPER_CPU_THREADS=4
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_BEST_OF=5
WHISPER_PATIENCE=1.0
WHISPER_VAD_MIN_SILENCE_MS=550
WHISPER_VAD_SPEECH_PAD_MS=450
WHISPER_HOTWORDS_MAX_CHARS=1200
WHISPER_PROMPT_MAX_CHARS=100
WHISPER_RETRY_LOW_CONFIDENCE=true
WHISPER_RETRY_CONFIDENCE_THRESHOLD=0.46
WHISPER_RETRY_BEAM_SIZE=7
STT_CORRECTION_ENABLED=true
STT_CORRECTION_MIN_SCORE=78
STT_CORRECTION_MIN_MARGIN=4
STT_SERVICE_URL=http://voice-service:5005/transcribe

VOICETUT_MODEL=mohammedaly22/VoiceTut-TTS
VOICETUT_SPEAKER=Mohamed
VOICETUT_DEVICE=cpu
VOICETUT_DTYPE=float32
VOICETUT_NUM_STEP=16
VOICETUT_GUIDANCE_SCALE=2.0
VOICETUT_SPEED=1.0
VOICETUT_NORMALIZE=true
VOICETUT_AUTO_PRELOAD=true
TTS_SERVICE_URL=http://voicetut-service:5010
TTS_FALLBACK_SERVICE_URL=http://voice-service:5005
TTS_PROVIDER=edge
EDGE_TTS_VOICE=ar-EG-ShakirNeural
EDGE_TTS_RATE=-4%
EDGE_TTS_VOLUME=+0%
EDGE_TTS_PITCH=+0Hz
EDGE_TTS_FALLBACK_PIPER=true
EGYPTIAN_SPOKEN_STYLE=true
PIPER_VOICE=ar_JO-kareem-medium
VOICE_MAX_AUDIO_BYTES=10485760
VOICE_MAX_TTS_CHARS=5000
VOICE_STT_TIMEOUT_MS=120000
VOICE_TTS_TIMEOUT_MS=300000

NEXT_PUBLIC_TRPC_HTTP_URL=http://localhost:4000/trpc
NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:4000/voice
NEXT_PUBLIC_APP_NAME=مساعد قانون المرور المصري
